# The only key you need for dev: powers the AI coach in the Python Lab.
# Leave it out and everything except the coach still works.
OPENAI_API_KEY=

# Optional extra providers
# ANTHROPIC_API_KEY=

# Production only — unset means auth is DISABLED and everyone shares one
# local dev user. That is the intended mode for a classroom training.
# JWT_SECRET=
# COOKIE_SECURE=true
# DATABASE_URL=postgresql://app:app@db:5432/python_lab

# Non-default frontend origin (comma-separated, no trailing slashes)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seconds a participant script may run before it is killed
# PY_RUN_TIMEOUT=15
